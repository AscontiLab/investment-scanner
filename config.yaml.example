# Investment Scanner — Konfiguration
# ────────────────────────────────────

# Grundstuecke
max_price: 50000          # EUR Maximalpreis
regions:
  - berlin
  - brandenburg
  - mecklenburg
  - sachsen-anhalt
  - sachsen

# Crowdfunding
min_rendite: 4.0          # % p.a. Mindestrendite

# Scraping
pause_seconds: 1.5        # Pause zwischen HTTP-Requests

# DGA Company-Mapping (Buchstabe → Name)
dga_companies:
  D: DGA
  S: "Sächsische"
  N: Norddeutsche
  W: Westdeutsche
  P: Plettner

# DGA Kategorie-Mapping (Code → Anzeigename)
dga_categories:
  GRDBG: "Grundstück"
  ETWTE: Eigentumswohnung
  EFHZFH: "Ein-/Zweifamilienhaus"
  MFHWGH: Mehrfamilienhaus
  GE: Gewerbe
  Special: Sonderobjekt

# KI-Scoring (Ollama)
ollama:
  url: "http://localhost:11434"
  model: "gemma4:e4b"
  batch_size: 20
  timeout: 120            # Sekunden
  pause: 2                # Sekunden zwischen Aufrufen

# Deep Scoring (Stufe 2 — Dokumente laden + neu bewerten)
deep_scoring:
  model_strategy: auto        # auto | gemma | claude
  min_ki_score: 7.0           # Auto-Trigger ab diesem Score
  batch_size: 10              # Max pro automatischem Lauf
  max_text_gemma: 6000        # Max Zeichen fuer Gemma
  max_text_claude: 20000      # Max Zeichen fuer Claude
  num_predict_gemma: 600      # Ollama Token-Limit
  claude_model: "claude-sonnet-4-20250514"
  claude_categories:          # Immer Claude bei diesen Kategorien
    - Mehrfamilienhaus
    - Gewerbe
    - Sonderobjekt

# ZVG Bundeslaender (Name → land_abk Code)
zvg_bundeslaender:
  Berlin: be
  Brandenburg: br
  Mecklenburg-VP: mv
  Sachsen: sn
  Sachsen-Anhalt: st
